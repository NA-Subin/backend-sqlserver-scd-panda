MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=scd_panda
MSSQL_USER=sa
MSSQL_PASSWORD=changeme
# Set to true for Azure SQL / any server requiring TLS.
MSSQL_ENCRYPT=false
# Set to false once the server presents a CA-signed certificate.
MSSQL_TRUST_SERVER_CERTIFICATE=true
JWT_SECRET=changeme
# Different from the Postgres backend's 4000 so both can run side by side.
PORT=4001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
